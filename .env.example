# EventPulse AI - WEB APPLICATION environment (hosted on Render with PostgreSQL).
# Copy the NAMES into Render's "Environment" settings; put the real values ONLY there (mark secrets
# as secret). Never commit real values, and never put them in source code. This file holds no secrets.
# The desktop app does not read any of these: it always uses its local SQLite database.

# --- required in production (the server refuses to start if one is missing or unsafe)
EVENTPULSE_ENV=production
EVENTPULSE_PUBLIC_BASE_URL=https://<your-service-name>.onrender.com
EVENTPULSE_TRUSTED_PROXIES=*                 # Render's proxy is the only way in; 1 hop
EVENTPULSE_PROXY_HOPS=1
EVENTPULSE_DB_URL=<Render "Internal Database URL" - secret>
EVENTPULSE_DB_ALLOW_PUBLIC_SCHEMA=1          # Render's free database: one owner account, schema "public" (no Data API)

# --- time zone (check-in "event day only" uses this; the web process also runs in it)
EVENTPULSE_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# --- one-time administrator creation at start-up (free tier has no shell). Created ONLY if no
#     administrator exists; never resets one. DELETE EVENTPULSE_ADMIN_PASSWORD after the first start.
EVENTPULSE_ADMIN_EMAIL=<organiser e-mail>
EVENTPULSE_ADMIN_NAME=<organiser name>
EVENTPULSE_ADMIN_PASSWORD=<strong password, 10+ chars with letters and digits - secret>

# --- optional demonstration content (labelled SYNTHETIC; only seeded into an EMPTY database)
EVENTPULSE_SEED_SYNTHETIC_DEMO=1
EVENTPULSE_HOSTED_MODELS_DIR=models_hosted   # built by the build command below

# --- defaults that normally need no change
# EVENTPULSE_ALLOWED_EMAIL_DOMAINS=ncuindia.edu
# EVENTPULSE_HASH_CONCURRENCY=2
# EVENTPULSE_DB_CONNECT_TIMEOUT=10
# EVENTPULSE_DB_APP_NAME=eventpulse
# WEB_CONCURRENCY=1                          # must stay 1 (in-memory limits)
PYTHON_VERSION=3.12.8                        # the verified Python version for requirements-web.txt
